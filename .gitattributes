# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# The reference packages are binary: never convert their line ends
tests/golden/** -text

# The data of the 3D printing materials keeps its line ends on every platform
crates/printmaterials/data/**/*.json -text
crates/printmaterials/THIRD_PARTY_NOTICES -text

# The machining data of the materials keeps its line ends on every platform
crates/materials/data/machining/*.json -text

# The sample of the .eh3d project is binary too
crates/project/tests/data/** -text
