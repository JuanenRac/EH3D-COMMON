# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# The reference packages are binary: never convert their line ends
tests/golden/** -text

# The data of the 3D printing materials keeps its line ends on every platform
crates/printmaterials/data/**/*.json -text
crates/printmaterials/THIRD_PARTY_NOTICES -text
